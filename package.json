{
  "name": "your-life-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import-sqlite": "tsx scripts/migrate-sqlite-to-pg.ts",
    "db:backup": "sh -c 'mkdir -p data/backups && pg_dump \"$DATABASE_URL\" -Fc -f data/backups/your-life-$(date +%Y%m%d-%H%M%S).dump'",
    "db:pull": "tsx scripts/pull-db.ts",
    "db:restore": "sh -c 'test -n \"$1\" && pg_restore --clean --if-exists --no-owner -d \"$DATABASE_URL\" \"$1\"' --",
    "check:finance": "tsx scripts/check-finance.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
